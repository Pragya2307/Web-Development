<!DOCTYPE html>
<html>
<head>
    <title>CSS Types</title>

  
    <style>
        h2 {
            color: blue;
            text-align: center;
        }

        p {
            font-size: 16px;
            color: green;
        }
    </style>

    
    <link rel="stylesheet" href="style.css">
</head>

<body>

    
    <h1 style="color: red; text-align: center;">
        Inline CSS Example
    </h1>

    <h2>Internal CSS Example</h2>

    <p>
        This paragraph is styled using Internal CSS.
    </p>

    <div class="box">
        This div is styled using External CSS.
    </div>

</body>
</html>
