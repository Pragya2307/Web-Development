<!DOCTYPE html>
<html>
<head>
    <title>HTML Table Layout</title>
</head>

<body>

    <h2>Student Information Table</h2>

    <table border="1" align="center" cellpadding="10" cellspacing="0">
        <caption><b>Student Details</b></caption>

        <tr align="center">
            <th rowspan="2">Roll No</th>
            <th rowspan="2">Name</th>
            <th colspan="3">Marks</th>
        </tr>

        <tr align="center">
            <th>Maths</th>
            <th>Science</th>
            <th>Computer</th>
        </tr>

        <tr align="center">
            <td>1</td>
            <td>Rahul</td>
            <td>85</td>
            <td>78</td>
            <td>90</td>
        </tr>

        <tr align="center">
            <td>2</td>
            <td>Anita</td>
            <td>88</td>
            <td>92</td>
            <td>95</td>
        </tr>

    </table>

</body>
</html>
